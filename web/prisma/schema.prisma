generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [postgis]
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  
  reports   PotholeReport[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PotholeReport {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  
  latitude    Float
  longitude   Float
  imageUrl    String
  
  severity    String   // LOW, MEDIUM, HIGH, CRITICAL
  confidence  Float
  status      String   @default("REPORTED") // REPORTED, ACKNOWLEDGED, IN_PROGRESS, RESOLVED
  
  senderEmail String?
  targetEmail String?
  
  locationName String? // Reverse geocoded location name
  reportCount Int      @default(1) // For deduplication (if multiple people report the same one)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  municipalityId String?
  municipality   Municipality? @relation(fields: [municipalityId], references: [id])
}

model Municipality {
  id          String   @id @default(uuid())
  name        String   @unique
  email       String   // The email to send reports to
  geom        Unsupported("geometry(Polygon, 4326)")?
  
  reports     PotholeReport[]
}
